# Copy to .env.local and fill in ONE of the options so the online AI works on your computer.
# On Vercel none of this is needed: the AI Gateway authenticates by itself (OIDC).

# Option 1: Vercel AI Gateway key (Vercel dashboard → AI Gateway → API Keys)
AI_GATEWAY_API_KEY=

# Option 2: free Gemini key (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional
# CABEAI_GEMINI=gemini-flash-latest
# CABEAI_MODELOS=inclusionai/ling-3.1-flash-free,poolside/laguna-s-2.1-free
# AI Gateway model that reads images, for building the plan from a sketch photo (Gemini above is tried first):
# CABEAI_MODELO_VISAO=google/gemini-2.5-flash
